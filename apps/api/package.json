    "@types/pg": "^8.20.0",
    "@types/snarkjs": "^0.7.9",
    "@vitest/coverage-v8": "^3.2.7",
    "c12": "^3.1.0",
    "fast-check": "^3.23.2",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.1",
    "prisma": "^7.9.0",
    "toxiproxy-node-client": "^4.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "unpkg": "^0.2.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
