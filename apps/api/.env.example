DATABASE_URL="postgresql://user:password@localhost:5432/stellar_alerts?schema=public&connection_limit=20&pool_timeout=10"
# Optional read replica. Read-only queries fall back to DATABASE_URL when unset.
DATABASE_REPLICA_URL=""
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
JWT_SECRET="super-secret-jwt-key"
REDIS_URL="redis://localhost:6379"

# Soroban Rent Renewal Worker Configuration
SOROBAN_RENT_WORKER_ENABLED="true"
SOROBAN_RENT_WORKER_INTERVAL_MS="60000"
SOROBAN_RENT_WORKER_SECRET="SC...your-stellar-secret-key..."
SOROBAN_RENT_RENEWAL_THRESHOLD="5000"
SOROBAN_RENT_TARGET_TTL="10000"
SOROBAN_RENT_MAX_CONCURRENCY="5"
